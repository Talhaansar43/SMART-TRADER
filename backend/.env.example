"""
Smart Trader Backend Configuration

Database URL Format:
postgresql://user:password@localhost:5432/smart_trader

Create database:
sudo -u postgres createdb smart_trader
"""

# Database
DATABASE_URL=postgresql://smarttrader:smarttrader123@localhost:5432/smart_trader

# API Keys (get from respective services)
OPENAI_API_KEY=your_openai_api_key_here
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here

# Security
SECRET_KEY=your-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_URL=redis://localhost:6379/0

# Application
APP_NAME=Smart Trader
DEBUG=True
ENVIRONMENT=development

# Cors
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]
